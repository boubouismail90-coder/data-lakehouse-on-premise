POSTGRES_USER=your_postgres_user
POSTGRES_PASSWORD=your_secure_postgres_password
POSTGRES_DB=your_postgres_database
POSTGRES_PORT=5432

AIRFLOW_IMAGE_NAME=apache/airflow:3.3.0-python3.12
AIRFLOW_UID=50000

AIRFLOW_ADMIN_USERNAME=your_airflow_admin_username
AIRFLOW_ADMIN_PASSWORD=your_secure_airflow_admin_password
AIRFLOW_ADMIN_FIRSTNAME=your_first_name
AIRFLOW_ADMIN_LASTNAME=your_last_name
AIRFLOW_ADMIN_EMAIL=your_email@example.com

AIRFLOW_API_SECRET_KEY=your_secure_airflow_secret_key
AIRFLOW_JWT_SECRET=your_secure_random_jwt_secret
